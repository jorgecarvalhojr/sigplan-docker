# .env.local.example — Exemplo de variáveis para desenvolvimento local
# Copie para .env.local e preencha com seus valores reais.
# NUNCA commite o .env.local no git!

# ─────────────────────────────────────────────
# Supabase Auth (mantido no cloud — apenas autenticação)
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...sua-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...sua-service-role-key...

# ─────────────────────────────────────────────
# PostgreSQL (local via Docker)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://sigplan:sigplan123@localhost:5432/sigplan
DATABASE_SSL=false

# Para o docker-compose.override.yml
POSTGRES_USER=sigplan
POSTGRES_PASSWORD=sigplan123
POSTGRES_DB=sigplan

# ─────────────────────────────────────────────
# Storage de "Resultados e Produtos" (PDFs)
# Sistema de arquivos local, persistido no volume Docker
# `resultados_data:/app/storage`. Opcional — só defina se quiser
# usar um caminho diferente do padrão (/app/storage/resultados).
# ─────────────────────────────────────────────
# RESULTADOS_STORAGE_DIR=/app/storage/resultados

# ─────────────────────────────────────────────
# Configurações de E-mail (SMTP)
# ─────────────────────────────────────────────
MAIL_HOST=mangote.cbmerj.rj.gov.br
MAIL_PORT=587
MAIL_USER=sigplan@defesacivil.rj.gov.br
MAIL_PASSWORD=Cel@284612
MAIL_ENCRYPTION=tls
