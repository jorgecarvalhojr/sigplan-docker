# .env.template — Referência para desenvolvimento local (envsubst < .env.template > .env)
#
# NÃO é mais usado pelo pipeline do GitLab CI: produção e homologação usam
# ArgoCD/Kubernetes, que injeta as variáveis via Secret/ConfigMap do cluster
# (ver .gitlab-ci.yml). Este arquivo serve só de referência do que a aplicação
# espera encontrar em process.env, e para gerar .env.local manualmente.

# ─────────────────────────────────────────────
# Autenticação CBMERJ (SOAP API / Custom Auth)
# ─────────────────────────────────────────────
CBMERJ_LOCATION=${CBMERJ_LOCATION}
CBMERJ_URI=${CBMERJ_URI}
SECRET_ID=${SECRET_ID}
SECRET_KEY=${SECRET_KEY}
SESSION_SECRET=${SESSION_SECRET}

# ─────────────────────────────────────────────
# Configurações do Next.js
# ─────────────────────────────────────────────
NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH}

# ─────────────────────────────────────────────
# Banco de dados PostgreSQL
# Local:    host=postgres (container), port=5432
# Produção: host do servidor PostgreSQL externo do CBMERJ
# ─────────────────────────────────────────────
DB_HOST=${DB_HOST}
DB_PORT=${DB_PORT}
DB_NAME=${DB_NAME}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_SSL=${DB_SSL}

# Variáveis usadas pelo docker-compose.override.yml (apenas local, sobe o container postgres)
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=${POSTGRES_DB}

# ─────────────────────────────────────────────
# Storage de "Resultados e Produtos" (PDFs)
# Sistema de arquivos local, persistido no volume Docker
# `resultados_data:/app/storage`. Opcional — só defina se quiser
# usar um caminho diferente do padrão (/app/storage/resultados).
# ─────────────────────────────────────────────
# RESULTADOS_STORAGE_DIR=/app/storage/resultados

# ─────────────────────────────────────────────
# Configurações de E-mail (SMTP)
# ─────────────────────────────────────────────
MAIL_HOST=${MAIL_HOST}
MAIL_PORT=${MAIL_PORT}
MAIL_USER=${MAIL_USER}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_ENCRYPTION=${MAIL_ENCRYPTION}
