# .env.template — Template para geração dinâmica do .env via GitLab CI
# Uso: envsubst < .env.template > .env
# Variáveis marcadas com ${VAR} são substituídas pelas GitLab CI/CD Variables

# ─────────────────────────────────────────────
# Autenticação CBMERJ (SOAP API / Custom Auth)
# ─────────────────────────────────────────────
CBMERJ_LOCATION=${CBMERJ_LOCATION}
CBMERJ_URI=${CBMERJ_URI}
SECRET_ID=${SECRET_ID}
SECRET_KEY=${SECRET_KEY}
SESSION_SECRET=${SESSION_SECRET}

# ─────────────────────────────────────────────
# Configurações do Next.js
# ─────────────────────────────────────────────
NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH}

# ─────────────────────────────────────────────
# Banco de dados PostgreSQL
# Local:    postgresql://sigplan:senha@postgres:5432/sigplan
# Produção: postgresql://user:senha@HOST_EXTERNO:5432/sigplan
# ─────────────────────────────────────────────
DATABASE_URL=${DATABASE_URL}
DATABASE_SSL=${DATABASE_SSL}

# Variáveis usadas pelo docker-compose.override.yml (apenas local)
POSTGRES_USER=${POSTGRES_USER}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_DB=${POSTGRES_DB}

# ─────────────────────────────────────────────
# Storage de "Resultados e Produtos" (PDFs)
# Sistema de arquivos local, persistido no volume Docker
# `resultados_data:/app/storage`. Opcional — só defina se quiser
# usar um caminho diferente do padrão (/app/storage/resultados).
# ─────────────────────────────────────────────
# RESULTADOS_STORAGE_DIR=/app/storage/resultados

# ─────────────────────────────────────────────
# Configurações de E-mail (SMTP)
# ─────────────────────────────────────────────
MAIL_HOST=${MAIL_HOST}
MAIL_PORT=${MAIL_PORT}
MAIL_USER=${MAIL_USER}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_ENCRYPTION=${MAIL_ENCRYPTION}
